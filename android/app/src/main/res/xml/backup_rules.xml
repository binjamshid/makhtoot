<?xml version="1.0" encoding="utf-8"?>
<!--
  work item 1.1 (ANDROID_SPINE.md §2 D-312, §11). Governs
  `android:fullBackupContent` on Android 11 and below ONLY — Android 12+
  uses data_extraction_rules.xml instead (both are required at targetSdk 36,
  specifying only one leaves the whole project tree backed up on whichever
  API range the missing file doesn't cover).

  Restricted to exactly the D-312 trial DataStore blob: a Preferences
  DataStore file named `mk_trial_state`, which
  androidx.datastore.preferences.preferencesDataStoreFile(context,
  "mk_trial_state") resolves to <filesDir>/datastore/mk_trial_state.preferences_pb.
  Batch 6 · Agent 6.2 (trial implementation) MUST use exactly this file name
  — this agent runs first and the name is fixed here, not there.

  D-312 is explicit that this blob is unencrypted-but-HMAC-signed (an
  AndroidKeyStore-wrapped blob would not survive Auto Backup restore, since
  a Keystore key is destroyed on uninstall) — Auto Backup carrying it is
  therefore the correct, intended behaviour, not a leak.
-->
<full-backup-content>
    <include domain="file" path="datastore/mk_trial_state.preferences_pb" />
</full-backup-content>

<?xml version="1.0" encoding="UTF-8"?>
<Scheme
   LastUpgradeVersion = "1620"
   version = "1.7">
   <BuildAction
      parallelizeBuildables = "YES"
      buildImplicitDependencies = "YES">
      <BuildActionEntries>
         <BuildActionEntry
            buildForTesting = "YES"
            buildForRunning = "YES"
            buildForProfiling = "YES"
            buildForArchiving = "YES"
            buildForAnalyzing = "YES">
            <BuildableReference
               BuildableIdentifier = "primary"
               BlueprintIdentifier = "E637A3495CBD4E84818363E2"
               BuildableName = "Makhtoot.app"
               BlueprintName = "Makhtoot"
               ReferencedContainer = "container:Makhtoot.xcodeproj">
            </BuildableReference>
         </BuildActionEntry>
      </BuildActionEntries>
   </BuildAction>
   <!--
   MKFoundationTests/MKDesignSystemTests (and the rest of MakhtootKit's
   suite) are still SPM package test targets (MakhtootKit/Tests/), not
   native Xcode test targets — see docs/impl-log/WS-01.md for why those
   were never wired into this <TestAction> (the verified, fully-working
   invocation for that suite stays `xcodebuild test -scheme
   MakhtootKit-Package` run from `MakhtootKit/`, per docs/BUILD.md).

   FC-6 (AUDIT_2026-07-28.md): this <TestAction> now hosts the native
   MakhtootUITests target (added to project.pbxproj via the `xcodeproj`
   gem, Wave 0 · Agent 0.2), a genuinely different case from the SPM
   package targets above — a real PBXNativeTarget hosted by this scheme's
   own app target, which xcodebuild resolves without the "no test bundles
   available to test" issue that blocked the package-target wiring.
   -->
   <TestAction
      buildConfiguration = "Debug"
      selectedDebuggerIdentifier = "Xcode.DebuggerFoundation.Debugger.LLDB"
      selectedLauncherIdentifier = "Xcode.DebuggerFoundation.Launcher.LLDB"
      shouldUseLaunchSchemeArgsEnv = "YES">
      <Testables>
         <TestableReference
            skipped = "NO">
            <BuildableReference
               BuildableIdentifier = "primary"
               BlueprintIdentifier = "DD9A3916EDDB9DD8D43308E4"
               BuildableName = "MakhtootUITests.xctest"
               BlueprintName = "MakhtootUITests"
               ReferencedContainer = "container:Makhtoot.xcodeproj">
            </BuildableReference>
         </TestableReference>
      </Testables>
      <!-- Mirrors the LaunchAction's own StoreKitConfigurationFileReference
           (WS-10 T11) below: a UI test's app-under-test is launched per
           THIS action's settings, not LaunchAction's, so
           PremiumExportPaywallGateUITests needs its own copy of this
           reference to get the same offline local-StoreKit-config
           behavior interactive runs already have. -->
      <StoreKitConfigurationFileReference
         identifier = "../../../Makhtoot/Config/Makhtoot.storekit">
      </StoreKitConfigurationFileReference>
   </TestAction>
   <LaunchAction
      buildConfiguration = "Debug"
      selectedDebuggerIdentifier = "Xcode.DebuggerFoundation.Debugger.LLDB"
      selectedLauncherIdentifier = "Xcode.DebuggerFoundation.Launcher.LLDB"
      launchStyle = "0"
      useCustomWorkingDirectory = "NO"
      ignoresPersistentStateOnLaunch = "NO"
      debugDocumentVersioning = "YES"
      debugServiceExtension = "internal"
      allowLocationSimulation = "YES">
      <!-- WS-10 T11: local StoreKit configuration for Debug launches
           (purchase/restore/grace/billing-retry simulation without a
           sandbox Apple ID). Path is container-relative from this
           .xcscheme file's own location
           (Makhtoot.xcodeproj/xcshareddata/xcschemes/) up to the repo
           root, then into Makhtoot/Config/ where the file physically
           lives (same directory as Info.plist) — the canonical copy is
           MakhtootKit/Sources/MKStore/Makhtoot.storekit (SPM package
           resource, used by MKStoreTests); this is a deliberate second
           copy for the Xcode scheme, kept in sync by hand (documented in
           docs/impl-log/WS-10.md). -->
      <StoreKitConfigurationFileReference
         identifier = "../../../Makhtoot/Config/Makhtoot.storekit">
      </StoreKitConfigurationFileReference>
      <BuildableProductRunnable
         runnableDebuggingMode = "0">
         <BuildableReference
            BuildableIdentifier = "primary"
            BlueprintIdentifier = "E637A3495CBD4E84818363E2"
            BuildableName = "Makhtoot.app"
            BlueprintName = "Makhtoot"
            ReferencedContainer = "container:Makhtoot.xcodeproj">
         </BuildableReference>
      </BuildableProductRunnable>
   </LaunchAction>
   <ProfileAction
      buildConfiguration = "Release"
      shouldUseLaunchSchemeArgsEnv = "YES"
      savedToolIdentifier = ""
      useCustomWorkingDirectory = "NO"
      debugDocumentVersioning = "YES">
      <BuildableProductRunnable
         runnableDebuggingMode = "0">
         <BuildableReference
            BuildableIdentifier = "primary"
            BlueprintIdentifier = "E637A3495CBD4E84818363E2"
            BuildableName = "Makhtoot.app"
            BlueprintName = "Makhtoot"
            ReferencedContainer = "container:Makhtoot.xcodeproj">
         </BuildableReference>
      </BuildableProductRunnable>
   </ProfileAction>
   <AnalyzeAction
      buildConfiguration = "Debug">
   </AnalyzeAction>
   <ArchiveAction
      buildConfiguration = "Release"
      revealArchiveInOrganizer = "YES">
   </ArchiveAction>
</Scheme>
